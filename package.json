{
  "name": "ollaic",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --dir design dev",
    "build": "pnpm --dir design build",
    "lint": "pnpm --dir design lint",
    "typecheck": "pnpm --dir design typecheck",
    "preview": "pnpm --dir design preview",
    "test": "pnpm --dir design test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "pnpm --dir design test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:harness": "cargo test --features agent-harness --manifest-path src-tauri/Cargo.toml",
    "agent-harness": "cargo run --quiet --features agent-harness --bin agent-harness --manifest-path src-tauri/Cargo.toml --",
    "e2e:web": "pnpm --dir design e2e:web",
    "verify": "pnpm build && pnpm test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:dev": "bash scripts/android-native.sh dev",
    "android:build": "bash scripts/android-native.sh build",
    "android:open": "bash scripts/android-native.sh open",
    "ios:dev": "bash scripts/ios-native.sh dev",
    "ios:build": "bash scripts/ios-native.sh build",
    "ios:open": "bash scripts/ios-native.sh open",
    "android:tauri:dev": "tauri android dev",
    "android:tauri:build": "tauri android build --apk --target aarch64",
    "android:tauri:open": "tauri android dev --open"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}
