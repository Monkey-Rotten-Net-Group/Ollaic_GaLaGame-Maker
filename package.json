{
  "name": "ollaic",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "lint": "pnpm --dir apps/desktop lint",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "preview": "pnpm --dir apps/desktop preview",
    "test": "pnpm --dir apps/desktop test && pnpm test:rust",
    "test:ui": "pnpm --dir apps/desktop test",
    "test:rust": "cargo test --locked --workspace",
    "test:core": "cargo test --locked -p ollaic-core",
    "bindings:test:swift": "bash scripts/test-swift-bindings.sh",
    "test:harness": "cargo test --features agent-harness --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "agent-harness": "cargo run --quiet --features agent-harness --bin agent-harness --manifest-path apps/desktop/src-tauri/Cargo.toml --",
    "e2e:web": "pnpm --dir apps/desktop e2e:web",
    "verify": "pnpm build && pnpm test",
    "tauri": "pnpm --dir apps/desktop exec tauri",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build": "pnpm tauri build",
    "android:dev": "bash scripts/android-native.sh dev",
    "android:build": "bash scripts/android-native.sh build",
    "android:test": "bash scripts/android-native.sh test",
    "android:test:unit": "bash scripts/android-native.sh unit-test",
    "android:test:bindings": "bash scripts/android-native.sh bindings-test",
    "android:test:ui": "bash scripts/android-native.sh ui-test",
    "android:test:preview": "bash scripts/android-native.sh preview-test",
    "android:open": "bash scripts/android-native.sh open",
    "ios:dev": "bash scripts/ios-native.sh dev",
    "ios:build": "bash scripts/ios-native.sh build",
    "ios:open": "bash scripts/ios-native.sh open"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}
